{
  "family": "lawyer-ai",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "REPLACE_WITH_ECS_TASK_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_LAWYER_AI_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "lawyer-ai",
      "image": "REPLACE_AT_DEPLOYMENT",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "FASTAPI_PORT", "value": "8000" },
        { "name": "FASTAPI_INTERNAL_URL", "value": "http://127.0.0.1:8000" },
        { "name": "INDIAN_LAWYER_DATASET_AUTO_INDEX", "value": "true" }
      ],
      "secrets": [
        {
          "name": "RIME_API_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:RIME_API_KEY::"
        },
        {
          "name": "BEY_API_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:BEY_API_KEY::"
        },
        {
          "name": "BEYOND_PRESENCE_AVATAR_ID",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:BEYOND_PRESENCE_AVATAR_ID::"
        },
        {
          "name": "LIVEKIT_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:LIVEKIT_URL::"
        },
        {
          "name": "LIVEKIT_API_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:LIVEKIT_API_KEY::"
        },
        {
          "name": "LIVEKIT_API_SECRET",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:LIVEKIT_API_SECRET::"
        },
        {
          "name": "QDRANT_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:QDRANT_URL::"
        },
        {
          "name": "QDRANT_API_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:QDRANT_API_KEY::"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:OPENAI_API_KEY::"
        },
        {
          "name": "HUGGINGFACE_API_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:HUGGINGFACE_API_KEY::"
        },
        {
          "name": "SUPABASE_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:SUPABASE_URL::"
        },
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:SUPABASE_SERVICE_ROLE_KEY::"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:DATABASE_URL::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:JWT_SECRET::"
        },
        {
          "name": "VITE_APP_ID",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:VITE_APP_ID::"
        },
        {
          "name": "OAUTH_SERVER_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:OAUTH_SERVER_URL::"
        },
        {
          "name": "VITE_OAUTH_PORTAL_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:VITE_OAUTH_PORTAL_URL::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://127.0.0.1:3000/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "REPLACE_WITH_CLOUDWATCH_LOG_GROUP",
          "awslogs-region": "REPLACE_WITH_AWS_REGION",
          "awslogs-stream-prefix": "lawyer-ai"
        }
      }
    }
  ]
}
